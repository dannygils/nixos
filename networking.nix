# networking.nix: Hostname, NetworkManager, DNS, and extra /etc/hosts entries
{ ... }:
{
  ############################
  # Hostname
  ############################
  networking.hostName = "nixos";

  ############################
  # NetworkManager
  ############################
  networking.networkmanager.enable = true;

  ############################
  # DNS Configuration
  ############################
  # Disable NM's dnsmasq handling; use custom DNS.
  # insertNameservers is not needed -- with dns = "none", networking.nameservers
  # is what writes /etc/resolv.conf.
  networking.networkmanager.dns = "none";
  networking.nameservers = [ "192.168.1.53" ];

  ############################
  # Static Host Entries
  ############################
  # localhost / ::1 / the hostname are generated by NixOS already, and
  # nixos.local would shadow Avahi's own mDNS record for this machine.
  networking.extraHosts = ''
    192.168.1.69 tower.local
    192.168.1.195 homeassistant.local
  '';

}
